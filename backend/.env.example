# Backend Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated list)
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# File Upload Configuration
MAX_FILE_SIZE_MB=500
TEMP_UPLOAD_DIR=./temp_uploads
DATA_INPUT_DIR=../data/input
DATA_OUTPUT_DIR=../data/output

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/api.log

# Supported Encodings
SUPPORTED_ENCODINGS=utf-8,utf-8-sig,windows-1252,latin-1,iso-8859-15

# Supported Delimiters
SUPPORTED_DELIMITERS=,;

# Required CSV Headers (comma-separated)
REQUIRED_HEADERS=ID de incidencia,Descripción,Estatus,Fecha de envío,Grupo asignado,Urgencia,Impacto
