# ==============================================================================
# Configuración de Confluence (necesario para ingesta mediante --url)
# ==============================================================================
# Para Confluence Cloud (atlassian.net): indicar URL base, correo y API Token
# Para Confluence Server / Data Center: basta con URL base y Personal Access Token (PAT) en CONFLUENCE_TOKEN
CONFLUENCE_URL=https://tu-dominio.atlassian.net
CONFLUENCE_USER=tu_correo@dominio.com
CONFLUENCE_TOKEN=tu_api_token_o_pat

# Desactivar verificación SSL si te encuentras detrás de proxy corporativo con inspección SSL
CONFLUENCE_VERIFY_SSL=false

# ==============================================================================
# Asistencia opcional con Modelos de Lenguaje (--use-llm)
# ==============================================================================
GEMINI_API_KEY=
OPENAI_API_KEY=
