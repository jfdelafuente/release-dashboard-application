{
  "name": "Release Dashboard Application",
  "version": "0.2.0",
  "description": "Aplicación web con dashboards interactivos para análisis de incidencias masivas y postmortems",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/release-dashboard-application"
  },
  "structure": {
    "src": {
      "converters": "Python modules for CSV to JSON conversion with validation and normalization",
      "dashboards": "HTML dashboards and supporting assets (CSS, JavaScript)"
    },
    "scripts": {
      "bin": "Converter wrapper scripts (batch and shell)",
      "deploy": "Deployment orchestration scripts (deploy.sh, rollback.sh, health-check.sh)"
    },
    "data": {
      "input": "CSV files for conversion (protected by .gitignore)",
      "output": "JSON files generated by converters",
      "errors": "Error reports from conversion validation",
      "archive": "Historical/archived data files"
    },
    "docs": "Project documentation (setup, deployment, contributing guides)",
    "config": "Configuration templates and environment management",
    "tests": "Test suite for converters and data validation",
    "specs": "Feature specifications and implementation plans"
  },
  "features": [
    {
      "id": "massive-incidents-dashboard",
      "name": "Massive Incidents Dashboard",
      "description": "Real-time KPIs and temporal analysis of incident data",
      "location": "dashboards/massive-incidents/index.html",
      "status": "production"
    },
    {
      "id": "postmortem-dashboard",
      "name": "Postmortem Dashboard",
      "description": "Analysis of postmortem incidents by deployment and segment",
      "location": "dashboards/postmortem/index.html",
      "status": "production"
    },
    {
      "id": "release-kpis-dashboard",
      "name": "Release KPIs Dashboard (Historical)",
      "description": "Standalone, self-contained view of historical release KPIs (PaP/Post incident volume and resolution %) with a 75% KPI threshold indicator. Uses a static, hand-maintained dataset (dashboards/release-kpis/releases-data.js) instead of the CSV/converters pipeline.",
      "location": "dashboards/release-kpis/index.html",
      "status": "production"
    },
    {
      "id": "dashboard-portal",
      "name": "Dashboard Portal (Principal)",
      "description": "Central access point for all dashboards with auto-loading of data",
      "location": "dashboards/portal/index.html",
      "status": "production"
    },
    {
      "id": "csv-to-json-converter",
      "name": "CSV to JSON Converter",
      "description": "Converts incident CSV files to JSON with auto-detection of encoding and delimiters",
      "modules": ["src/converters/convert_incidents.py", "src/converters/csv_to_json/"],
      "status": "production"
    },
    {
      "id": "postmortem-converter",
      "name": "Postmortem Converter",
      "description": "Converts postmortem CSV files to JSON with KPI pre-calculation",
      "modules": ["src/converters/convert_postmortems.py"],
      "status": "production"
    }
  ],
  "infrastructure": {
    "deployment_target": "VPS (SSH-based)",
    "web_server": "Nginx (serves static files)",
    "application_server": "Python (executes converters)",
    "ci_cd": "GitHub Actions",
    "version_control": "Git with semantic versioning"
  },
  "deployment": {
    "staging": {
      "automatic": true,
      "trigger": "merge to main branch",
      "health_checks": "automatic"
    },
    "production": {
      "automatic": false,
      "requires_approval": true,
      "min_reviewers": 1,
      "rollback_capable": true,
      "health_checks": "automatic"
    }
  },
  "quality_gates": {
    "test_coverage": "≥80%",
    "test_command": "pytest --cov=src.converters tests/",
    "lint_enabled": true,
    "branch_protection": "required for main",
    "status_checks": ["test", "lint"]
  },
  "team": {
    "size": 1,
    "leads": ["jose.delafuente"]
  },
  "documentation": {
    "quickstart": "docs/QUICKSTART.md",
    "deployment": "docs/DEPLOYMENT.md",
    "contributing": "CONTRIBUTING.md",
    "development": "docs/DEVELOPMENT.md",
    "security": "SECURITY.md",
    "architecture": "docs/ARCHITECTURE.md"
  },
  "critical_files": {
    "version": "VERSION (semantic versioning)",
    "environment": "config/.env (local), GitHub Secrets (production)",
    "gitignore": ".gitignore (protects data/ and .env files)",
    "deployment_log": "logs/deployments/DEPLOYMENT-RECORDS.log"
  },
  "created_date": "2026-05-14",
  "last_updated": "2026-07-14"
}
