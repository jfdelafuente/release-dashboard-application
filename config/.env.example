# Release Dashboard Application - Environment Variables Template
# Copy this file to .env and set values for your environment
# WARNING: .env files are git-ignored - never commit actual credentials

# Application Environment
APP_ENV=development
DEBUG=True

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=standard

# Performance & Caching
CACHE_TTL=60

# Feature Flags
FEATURE_FLAGS={"advanced_filters": true, "experimental_features": false}

# Database (if needed)
DATABASE_URL=sqlite:///incidents.db

# External Services (API Keys, etc.)
# API_KEY=<your-api-key-here>

# Deployment Configuration
VERSION=0.1.0
DEPLOYMENT_ENVIRONMENT=development

# Secrets (use GitHub Secrets in production, not this file)
# PROD_DATABASE_URL=<production-database-url>
# PROD_API_KEY=<production-api-key>
