# ============================================
# Configuración de Release Dashboard Application (Servidor Estático y Motor Epsilon IA)
# ============================================

# Puerto del servidor estático de desarrollo (serve_app.py)
# Por defecto: 8080 (evita conflicto con FastAPI en el puerto 8000)
SERVE_APP_PORT=8080
PORT=8080

# --------------------------------------------
# Motor Epsilon Resumen IA y Modo de Conmutación
# --------------------------------------------
# Modos admitidos:
#   - internal                     : (Por defecto) Motor interno propio con data/resumen_incidencia_epsilon.md + Smart Fingerprint Cache
#   - internal_with_soptmc_fallback: Motor interno primero y fallback automático a SopTMC ante indisponibilidad del LLM
#   - soptmc                       : Flujo legado externo (consulta directa a soptmc.si.orange.es/MonTMC/api/epsilon/resumenIA)
EPSILON_PROVIDER_MODE=internal

# Pre-generación proactiva en background durante sincronización MonTMC (1=activo por defecto, 0=solo bajo demanda)
EPSILON_SYNC_PREGEN=1

# Proveedor LLM corporativo (Gateway LiteLLM  / Anthropic Claude recomendado)
# ANTHROPIC_AUTH_TOKEN=sk-...
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=anthropic/claude-sonnet-4-5
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-5


# Proveedores alternativos opcionales:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_API_KEY=AIza...

# Modo simulado offline sin llamadas a LLM (solo para desarrollo/tests):
# EPSILON_MOCK=0

# --------------------------------------------
# API Corporativa MonTMC / Remedy (Datos crudos de tickets)
# --------------------------------------------
# MON_TMC_BASE_URL=
# MON_TMC_USER=jdelat
# MON_TMC_DEFAULT_DAYS=3


